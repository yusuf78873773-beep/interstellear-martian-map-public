/* D_LET_EVW.FMT */                                                           
/* This file defines the structure of the eV part of Dosimetry LET */         
                                                                              
 INTERCHANGE_FORMAT      = ASCII                                              
 AXES                    = 1                                                  
 AXIS_ITEMS              = (44)                                               
 START_BYTE              = 1                                                  
                                                                              
  OBJECT           = ELEMENT                                                  
    NAME           = DOSE_LET_EV_WIDTH_COMPONENT_VALUE                        
    START_BYTE     = 1                                                        
    BYTES          = 13                                                       
    DATA_TYPE      = ASCII_REAL                                               
    UNIT           = "keV / micrometer"                                       
    DESCRIPTION    = "                                                        
      Dosimetry LET energy widths in keV / micrometer                         
      "                                                                       
  END_OBJECT       = ELEMENT                                                  
                                                                              
 /* End of D_LET_EVW.FMT */                                                   
