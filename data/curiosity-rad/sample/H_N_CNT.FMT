/* H_N_CNT.FMT */                                                             
/* This file defines the structure of the Cnt part of Neutral Histograms */   
                                                                              
 INTERCHANGE_FORMAT      = ASCII                                              
 AXES                    = 1                                                  
 AXIS_ITEMS              = (48)                                               
 START_BYTE              = 1                                                  
                                                                              
  OBJECT           = ELEMENT                                                  
    NAME           = HIST_N_CNT_COMPONENT_VALUE                               
    START_BYTE     = 1                                                        
    BYTES          = 13                                                       
    DATA_TYPE      = ASCII_REAL                                               
    UNIT           = "Counts"                                                 
    DESCRIPTION    = "                                                        
      Neutral Histogram: Counts portion of histogram                          
      "                                                                       
  END_OBJECT       = ELEMENT                                                  
                                                                              
 /* End of H_N_CNT.FMT */                                                     
